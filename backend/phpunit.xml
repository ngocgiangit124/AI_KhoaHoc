<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true" trên CẢ <env> lẫn <server> là BẮT BUỘC: container php chạy
             qua docker-compose `env_file` nạp thẳng backend/.env thành biến môi
             trường OS thật của tiến trình (có mặt ở cả $_ENV và $_SERVER). PHPUnit
             force="true" trên <env> chỉ ghi đè $_ENV/putenv(), Laravel env() lại ưu
             tiên đọc $_SERVER trước — thiếu <server> tương ứng, test sẽ âm thầm
             chạy nhầm vào DB dev thật thay vì DB test. Đã xác minh bằng test thực
             tế (Docker) trước khi thêm — đừng bỏ bớt khối <server> này. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- BUG-2 (QA T01/T02): mặc định RateLimiter::for()/`throttle` dùng
             config('cache.limiter') = 'redis-limiter' → Redis THẬT (REDIS_LIMITER_DB),
             dùng CHUNG giữa `testing` và `local`/production vì trước đây không bị
             override ở đây (chỉ MySQL được tách qua DB_DATABASE). Hệ quả: bộ đếm
             throttle còn sót giữa các lần chạy test làm test `throttle` flaky, và
             test có thể ảnh hưởng ngược lại bộ đếm rate-limit của môi trường dev
             thật. `array` là cache store trong tiến trình (không persist), mỗi test
             Pest có Application riêng (state không rò giữa các test) — cô lập hoàn
             toàn, không cần Redis khi chạy test. -->
        <env name="CACHE_LIMITER" value="array" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="mysql" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="vitaminvui_testing" force="true"/>
        <env name="DB_USERNAME" value="vitaminvui" force="true"/>
        <!-- DB_PASSWORD KHÔNG bị ép ở đây (khác mọi biến DB_* khác): từ M6
             (docs/security/review-T01-T02.md) mật khẩu DB local không còn cố
             định "secret" — mỗi máy có mật khẩu ngẫu nhiên riêng trong
             backend/.env (đọc backend/README.md §2.1). Container `php` nạp
             backend/.env qua `env_file` của docker-compose, tức DB_PASSWORD
             đã là biến môi trường OS THẬT của tiến trình (có ở cả $_ENV lẫn
             $_SERVER tự nhiên, không cần <server> đi kèm như các biến do
             chính PHPUnit gán) trước khi PHPUnit chạy — để trống ở đây thì
             Laravel dùng đúng mật khẩu thật đó, khớp user MySQL thật (cùng
             user/mật khẩu, chỉ khác tên database DB_DATABASE ở trên). Trên
             Claude Code on the web (không Docker), scripts/cloud-setup.sh tạo
             sẵn backend/.env với DB_PASSWORD=secret và user MySQL
             vitaminvui/secret khớp nhau — Laravel tự đọc từ .env, không cần
             phpunit.xml ép giá trị này.
        -->
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="APP_API_HOST" value="api.localhost" force="true"/>
        <env name="APP_ADMIN_API_HOST" value="admin-api.localhost" force="true"/>
        <env name="FRONTEND_URL" value="http://localhost:3000" force="true"/>
        <env name="ADMIN_URL" value="http://admin.localhost:3001" force="true"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:3000,admin.localhost:3001" force="true"/>
        <env name="TRUSTED_PROXIES" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>

        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_LIMITER" value="array" force="true"/>
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_HOST" value="mysql" force="true"/>
        <server name="DB_PORT" value="3306" force="true"/>
        <server name="DB_DATABASE" value="vitaminvui_testing" force="true"/>
        <server name="DB_USERNAME" value="vitaminvui" force="true"/>
        <!-- DB_PASSWORD cố ý không có ở đây — xem chú thích ở khối <env> phía trên. -->
        <server name="DB_URL" value="" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="APP_API_HOST" value="api.localhost" force="true"/>
        <server name="APP_ADMIN_API_HOST" value="admin-api.localhost" force="true"/>
        <server name="FRONTEND_URL" value="http://localhost:3000" force="true"/>
        <server name="ADMIN_URL" value="http://admin.localhost:3001" force="true"/>
        <server name="SANCTUM_STATEFUL_DOMAINS" value="localhost:3000,admin.localhost:3001" force="true"/>
        <server name="TRUSTED_PROXIES" value="" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
