APP_NAME=VitaminVui
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=90

# --- Topology 2 host API (ADR-004 §2.1) ---
APP_API_HOST=api.localhost
APP_ADMIN_API_HOST=admin-api.localhost
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://admin.localhost:3001
STATIC_URL=http://localhost:8080

# --- Phiên & proxy (ADR-004 §2.2, §2.4) ---
SANCTUM_STATEFUL_DOMAINS=localhost:3000,admin.localhost:3001
SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=vv_session
SESSION_ADMIN_COOKIE=vv_admin_session
# Danh sách IP cụ thể của load balancer / Next.js server, phân tách bởi dấu phẩy — KHÔNG BAO GIỜ "*".
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=vitaminvui_cache

# --- Database (MySQL 8.4 LTS — data-model §0) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vitaminvui
DB_USERNAME=vitaminvui
DB_PASSWORD=secret

# --- Redis (tách DB theo mục đích — ADR-004 §5) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_DB_SESSION=1
REDIS_CACHE_DB=2
REDIS_QUEUE_DB=3
REDIS_LIMITER_DB=4

# --- Mail (Mailpit local) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@vitaminvui.vn"
MAIL_FROM_NAME="${APP_NAME}"

# --- Thanh toán (ADR-001; boot guard cấm fake ở production — S4) ---
PAYMENT_GATEWAYS=fake
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_IPN_URL=
MOMO_REDIRECT_URL=

# --- Video (ADR-002) ---
VIDEO_PROVIDER=internal

# --- Chống bot & OTP ---
CAPTCHA_DRIVER=fake
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
AUTH_OTP_CHANNELS=email

# --- Dữ liệu cá nhân (S7) ---
PRIVACY_POLICY_VERSION=2026-09
PRIVACY_PARENT_CONSENT_AGE=18

# --- Feature flags (README §5) ---
FEATURE_REFERRAL_CODE=true
FEATURE_QUIZ_TIME_LIMIT=true
FEATURE_ZERO_TOTAL_CHECKOUT=true
FEATURE_ENROLLMENT_DECISION_MAIL=false
FEATURE_STAFF_MFA=true
FEATURE_EXTERNAL_VIDEO_PREVIEW_ONLY=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
