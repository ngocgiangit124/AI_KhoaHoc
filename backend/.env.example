APP_NAME=VitaminVui
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=90

# --- Topology 2 host API (ADR-004 §2.1) ---
APP_API_HOST=api.localhost
APP_ADMIN_API_HOST=admin-api.localhost
# Local: web phải CÙNG SITE với API (Chromium coi app.localhost và api.localhost là cross-site -> cookie SameSite=Lax bị bỏ, POST 419)
FRONTEND_URL=http://api.localhost:3000
ADMIN_URL=http://admin-api.localhost:3001
STATIC_URL=http://localhost:8080

# --- Phiên & proxy (ADR-004 §2.2, §2.4) ---
SANCTUM_STATEFUL_DOMAINS=api.localhost:3000,admin-api.localhost:3001
SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=vv_session
SESSION_ADMIN_COOKIE=vv_admin_session
# Danh sách IP cụ thể của load balancer / Next.js server, phân tách bởi dấu phẩy — KHÔNG BAO GIỜ "*".
TRUSTED_PROXIES=

# Token bí mật cho request SSR của Next.js (header X-Internal-Token) để throttle `catalog` tính theo IP khách
# thật (header X-Client-IP) thay vì chung 1 bucket theo IP server SSR. Để trống = tắt. Tối thiểu 32 ký tự:
# openssl rand -hex 32. Nginx PHẢI xoá 2 header này khỏi request từ internet.
INTERNAL_API_TOKEN=
# true: production từ chối khởi động nếu INTERNAL_API_TOKEN rỗng (bật khi SSR đã gửi header).
INTERNAL_API_REQUIRED=false
CATALOG_LIMIT_PER_MINUTE=120
# Trần tổng/phút của nguồn SSR; cũng là trần DUY NHẤT cho request token đúng không kèm X-Client-IP (ADR-004 §2.8).
CATALOG_SSR_TOTAL_PER_MINUTE=6000

# Vận hành queue/scheduler (T26) — mặc định trong config/ops.php
# OPS_WORKER_MAX_AGE=120
# OPS_SCHEDULER_MAX_AGE=180
# OPS_FAILED_JOBS_MAX=10
# OPS_QUEUE_BACKLOG_MAX=500

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=vitaminvui_cache

# --- Database (MySQL 8.4 LTS — data-model §0) ---
# M6 (review bảo mật T01/T02): giá trị dưới đây CHỈ là placeholder — đặt mật
# khẩu thật khi copy .env.example -> .env, và PHẢI khớp VV_DB_PASSWORD trong
# infra/.env (2 file mô tả cùng 1 mật khẩu MySQL, cho 2 phía: server container
# và client Laravel).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vitaminvui
DB_USERNAME=vitaminvui
DB_PASSWORD=doi_mat_khau_db_local

# --- Redis (tách DB theo mục đích — ADR-004 §5) ---
# Phải khớp VV_REDIS_PASSWORD trong infra/.env (M6).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=doi_mat_khau_redis_local
REDIS_DB_SESSION=1
REDIS_CACHE_DB=2
REDIS_QUEUE_DB=3
REDIS_LIMITER_DB=4

# --- Mail (Mailpit local) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@vitaminvui.vn"
MAIL_FROM_NAME="${APP_NAME}"

# --- Thanh toán (ADR-001; boot guard cấm fake ở production — S4) ---
PAYMENT_GATEWAYS=fake
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_IPN_URL=
MOMO_REDIRECT_URL=
MOMO_REQUEST_TYPE=captureWallet
MOMO_LINK_TTL_MINUTES=30
# Local/sandbox: thêm test-payment.momo.vn. Production CHỈ payment.momo.vn (mặc định).
MOMO_PAY_URL_HOSTS=payment.momo.vn,test-payment.momo.vn

# --- Video (ADR-002) ---
VIDEO_PROVIDER=internal
# Allowlist nhà cung cấp (mặc định = VIDEO_PROVIDER). `fake` chỉ local/testing, production cấm.
# VIDEO_ENABLED_PROVIDERS=internal
# VIDEO_MAX_UPLOAD_MB=1024
# VIDEO_DAILY_QUOTA_GB=20

# --- Bunny Stream (US-021, nhà cung cấp `bunny`) ---
# Dùng: VIDEO_PROVIDER=bunny (VIDEO_ENABLED_PROVIDERS=bunny,internal để video VideoLab cũ vẫn phát). Khi bunny bật cần ĐỦ 4 biến
# đầu; production/staging không khởi động nếu thiếu. KHÔNG commit giá trị thật; khoá chỉ nằm ở .env phía server.
# BUNNY_LIBRARY_ID=          # Video Library ID (số)
# BUNNY_API_KEY=             # API key của thư viện (Stream API key), dùng làm header AccessKey
# BUNNY_CDN_HOST=            # vz-xxxx.b-cdn.net hoặc tên miền riêng; https; khác host app/web/admin
# BUNNY_TOKEN_KEY=           # Token Authentication key của thư viện (bật Token Authentication ở Bunny)
# BUNNY_WEBHOOK_TOKEN=       # bí mật trên URL webhook (?k=), >= 32 ký tự (openssl rand -hex 32); bắt buộc ở production/staging
# BUNNY_API_BASE=https://video.bunnycdn.com
# BUNNY_TUS_ENDPOINT=https://video.bunnycdn.com/tusupload

# --- VideoLab (T12, nhà cung cấp `internal`) ---
# Local: để trống 3 khoá thì tự suy ra từ APP_KEY. Staging/production BẮT BUỘC đặt riêng (openssl rand -hex 32, ≥ 32 ký tự).
# VIDEOLAB_API_KEY=
# VIDEOLAB_TOKEN_KEY=
# VIDEOLAB_WEBHOOK_SECRET=
VIDEOLAB_HOST=video.localhost
# App → VideoLab (trong Docker qua Nginx) và URL trình duyệt dùng để upload/phát.
VIDEOLAB_INTERNAL_URL=http://nginx
VIDEOLAB_PUBLIC_URL=http://video.localhost:8000
# VideoLab → app (webhook xong/lỗi).
VIDEOLAB_WEBHOOK_URL=http://nginx/api/v1/webhooks/video/internal
# Bật khi Nginx có `location /_protected_hls/ { internal; }` (đã có ở local): giảm tải PHP khi phát.
VIDEOLAB_ACCEL_REDIRECT=false
# VIDEOLAB_CHUNK_MAX_MB=8

# --- Chống bot & OTP ---
CAPTCHA_DRIVER=fake
# Key TEST của Cloudflare (luôn pass) — CHỈ dùng cho local, không bao giờ dùng ở staging/production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=
# GL-A2: đăng nhập sai >= ngưỡng (theo tài khoản, 1 giờ) thì đòi captcha thay vì khoá; trần cứng (kể cả có captcha) -> 429.
AUTH_LOGIN_CAPTCHA_THRESHOLD=5
AUTH_LOGIN_MAX_FAILURES=100
AUTH_LOGIN_MAX_FAILURES_IP=200
AUTH_LOGIN_MAX_CAPTCHA_FAILURES_IP=1000
AUTH_LOGIN_CAPTCHA_REJECTS_PER_MINUTE=10
AUTH_LOGIN_CAPTCHA_REJECTS_PER_MINUTE_IP=120
AUTH_STAFF_LOGIN_CAPTCHA_THRESHOLD=5
AUTH_STAFF_LOGIN_MAX_FAILURES=100
AUTH_STAFF_LOGIN_MAX_FAILURES_IP=200
AUTH_STAFF_LOGIN_MAX_CAPTCHA_FAILURES_IP=1000
AUTH_OTP_CHANNELS=email
# Nới hạn mức gửi OTP/quên mật khẩu cho e2e (cooldown 1s, 1000/giờ...). CHỈ có hiệu lực khi APP_ENV=local|testing;
# production luôn giữ 1/phút, 5/giờ, 10/ngày dù biến này bật.
AUTH_OTP_E2E_RELAXED=false

# --- Dữ liệu cá nhân (S7) ---
PRIVACY_POLICY_VERSION=2026-10-tam
PRIVACY_PARENT_CONTACT_SUGGEST_AGE=18
# Khoá HMAC cho token/danh sách huỷ nhận thông báo phụ huynh. Production BẮT BUỘC đặt riêng (>= 32 byte, ví dụ `openssl rand -hex 32`),
# KHÔNG dẫn xuất từ APP_KEY và KHÔNG ĐƯỢC XOAY (xoay làm mất hiệu lực danh sách huỷ nhận). Local để trống được.
PRIVACY_NOTICE_TOKEN_KEY=
# Trần thư thông báo/địa chỉ phụ huynh/24h, hợp lệ 1..20 (ngoài khoảng: production không khởi động; ở local thì không gửi thư).
PRIVACY_PARENT_NOTICE_DAILY_CAP=5
# T29-S6: trần TỔNG thư gửi bên thứ ba/giờ (mọi địa chỉ); vượt thì bỏ thư và ghi cảnh báo. Mặc định 500; < 1 = không gửi.
PRIVACY_PARENT_NOTICE_GLOBAL_HOURLY_CAP=500

# --- Feature flags (README §5) ---
FEATURE_REFERRAL_CODE=true
FEATURE_QUIZ_TIME_LIMIT=true
FEATURE_ZERO_TOTAL_CHECKOUT=true
FEATURE_ENROLLMENT_DECISION_MAIL=false
FEATURE_STAFF_MFA=true
# Thông báo cho phụ huynh (ADR-006). Tắt khẩn: false.
FEATURE_PARENT_NOTICES=true
FEATURE_EXTERNAL_VIDEO_PREVIEW_ONLY=true
FEATURE_PAID_CHECKOUT=false
# US-022 (ADR-007): thanh toán thủ công "Liên hệ Quản trị viên". Local bật; production chỉ bật khi đã có kênh liên hệ thật.
FEATURE_MANUAL_PAYMENT=true
ORDERS_MANUAL_PENDING_TTL_HOURS=72
ORDERS_MANUAL_APPROVAL_WINDOW_DAYS=30
ORDERS_MANUAL_PER_DAY=5
# Số ngày giữ lời nhắn của học sinh (orders.customer_note) sau khi đơn kết thúc rồi tự xoá. Khoảng 30..3650.
ORDERS_CUSTOMER_NOTE_RETENTION_DAYS=90
# Số ngày giữ nội dung nhân viên tự nhập trên đơn (ghi chú nội bộ, mã giao dịch, ghi chú hoàn tiền, lý do huỷ) sau khi đơn kết thúc rồi tự xoá. Khoảng 1..3650.
ORDERS_STAFF_TEXT_RETENTION_DAYS=7
# Hộp thư nhận thông báo đơn mới (phân tách bằng dấu phẩy). Để trống hoặc xoá dòng = dùng SUPPORT_EMAIL.
ORDERS_MANUAL_NOTIFY_EMAILS=hotro@vitaminvui.vn
# Kênh liên hệ công khai hiển thị cho học sinh; kênh để trống thì không hiển thị.
PAYMENT_CONTACT_PHONE="0915 592 224"
PAYMENT_CONTACT_ZALO_URL=https://zalo.me/0915592224
PAYMENT_CONTACT_EMAIL=hotro@vitaminvui.vn
PAYMENT_CONTACT_HOURS="8h–17h"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
