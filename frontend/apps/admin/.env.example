# Quản trị (apps/admin). Sao chép thành .env.local (không commit).
# Local: admin chạy ở admin-api.localhost:3001 để CÙNG SITE với admin-api.localhost:8000 (xem apps/web/.env.example).
# Backend phải khớp: ADMIN_URL=http://admin-api.localhost:3001, SANCTUM_STATEFUL_DOMAINS có admin-api.localhost:3001.
NEXT_PUBLIC_ADMIN_API_URL=http://admin-api.localhost:8000
NEXT_PUBLIC_ADMIN_URL=http://admin-api.localhost:3001
NEXT_PUBLIC_STATIC_URL=http://localhost:8080
# Nơi trình duyệt tải video lên (TUS), cũng nằm trong CSP connect-src. Dùng Bunny thì đặt https://video.bunnycdn.com
NEXT_PUBLIC_VIDEO_UPLOAD_URL=http://video.localhost:8000
# Chỉ server (KHÔNG đặt NEXT_PUBLIC_). Bản xem trước design v2 (/v2/...) trả 404 ở production trừ khi V2_PREVIEW=1.
# Dev (next dev) luôn xem được, không cần đặt.
# V2_PREVIEW=1
# GL-A2: site key Cloudflare Turnstile cho form đăng nhập (widget hiện sau khi sai mật khẩu nhiều lần). Để TRỐNG ở file mẫu (như web).
# Production: BẮT BUỘC build với site key thật, trùng TURNSTILE_SITE_KEY của backend (thiếu = người bị đòi captcha không đăng nhập được).
# Local: đặt khoá thử của Cloudflare 1x00000000000000000000AA vào .env.local (luôn qua; backend CAPTCHA_DRIVER=fake) rồi khởi động lại dev server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Origin app web, chỉ cho liên kết ở trang xem trước /v2 (tuỳ chọn; để trống ở production).
NEXT_PUBLIC_WEB_URL=http://api.localhost:3000
