# Mẫu env PRODUCTION của apps/admin (T35-2, ADR-008 §8.9). Phần BUILD vào `vars` của GitHub Environment `production`;
# phần RUNTIME vào /opt/vitaminvui/env/admin.env trên server.
# Staging: dùng tên miền *-staging, static.vitaminvui-staging-media.net, site key Turnstile staging; V2_PREVIEW=1 được phép ở staging.
# Giá trị dưới đây là mẫu: thay bằng giá trị thật. File này KHÔNG chứa secret.

# ===== BUILD (GitHub Environment vars, nhúng vào bundle; công khai) =====
NEXT_PUBLIC_ADMIN_API_URL=https://admin-api.vitaminvui.vn
NEXT_PUBLIC_ADMIN_URL=https://admin.vitaminvui.vn
NEXT_PUBLIC_STATIC_URL=https://static.vitaminvui-media.net
# Nơi trình duyệt tải video lên (TUS). Dùng Bunny thì đặt https://video.bunnycdn.com
NEXT_PUBLIC_VIDEO_UPLOAD_URL=https://video.bunnycdn.com
# GL-A2: BẮT BUỘC site key Turnstile PRODUCTION (thiếu = người bị đòi captcha không đăng nhập được), trùng TURNSTILE_SITE_KEY của backend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAREPLACE_WITH_PRODUCTION_SITE_KEY

# ===== RUNTIME (/opt/vitaminvui/env/admin.env, không nhúng vào image) =====
# Production để TRỐNG (/v2 trả 404). Staging được đặt 1.
V2_PREVIEW=
