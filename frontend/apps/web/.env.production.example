# Mẫu env PRODUCTION của apps/web (T35-2, ADR-008 §8.9). Sao chép phần BUILD vào `vars` của GitHub Environment
# `production` (CI) hoặc xuất ra shell khi build local; phần RUNTIME vào /opt/vitaminvui/env/web.env trên server.
# Staging: dùng tên miền *-staging, static.vitaminvui-staging-media.net, site key Turnstile staging; V2_PREVIEW=1 được phép ở staging.
# Giá trị dưới đây là mẫu: thay bằng giá trị thật. File này KHÔNG chứa secret.

# ===== BUILD (GitHub Environment vars, nhúng vào bundle; công khai) =====
NEXT_PUBLIC_API_URL=https://api.vitaminvui.vn
NEXT_PUBLIC_SITE_URL=https://vitaminvui.vn
NEXT_PUBLIC_STATIC_URL=https://static.vitaminvui-media.net
NEXT_PUBLIC_VIDEO_HOSTS=https://cdn.vitaminvui.asia
# Site key Turnstile PRODUCTION (không dùng khoá thử 1x00000000000000000000AA), trùng TURNSTILE_SITE_KEY của backend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAREPLACE_WITH_PRODUCTION_SITE_KEY
# Để TRỐNG: MoMo tắt ở V1 (readiness D5/E2). Không đặt test-payment.momo.vn.
NEXT_PUBLIC_MOMO_HOSTS=

# ===== RUNTIME (/opt/vitaminvui/env/web.env, không nhúng vào image) =====
API_INTERNAL_URL=http://10.231.10.1:8081
# Secret, >= 32 ký tự, GIỐNG INTERNAL_API_TOKEN của backend. Chỉ đặt trên server.
INTERNAL_API_TOKEN=
# Production để TRỐNG (/v2 trả 404). Staging được đặt 1.
V2_PREVIEW=
