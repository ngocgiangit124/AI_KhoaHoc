# Web học sinh (apps/web). Sao chép thành .env.local (không commit).
# Local: web chạy ở api.localhost:3000 để CÙNG SITE với API (api.localhost:8000);
# Chromium coi localhost / app.localhost và api.localhost là cross-site -> cookie phiên bị bỏ, POST 419.
# Backend phải khớp: FRONTEND_URL=http://api.localhost:3000, SANCTUM_STATEFUL_DOMAINS có api.localhost:3000.
NEXT_PUBLIC_API_URL=http://api.localhost:8000
NEXT_PUBLIC_SITE_URL=http://api.localhost:3000
NEXT_PUBLIC_STATIC_URL=http://localhost:8080
# Host video cho CSP connect-src + media-src (kèm scheme, phân cách dấu phẩy). Trang học (FW4) cần để hls.js tải playlist/đoạn video:
# local VideoLab: http://video.localhost:8000 · Bunny: https://<CDN hostname của thư viện> (BUNNY_CDN_HOST). Để trống thì video KHÔNG phát được.
NEXT_PUBLIC_VIDEO_HOSTS=http://video.localhost:8000
# Để trống ở local (backend /config/public trả captcha_site_key).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_MOMO_HOSTS=test-payment.momo.vn
# Server-only (ADR-004 §2.8). Local: tên miền API + `extra_hosts: ["api.localhost:host-gateway"]` cho service web trong Docker
# (Nginx local định tuyến theo Host; fetch của Node không ghi đè được Host).
# Production: http://<IP_NOI_BO_NGINX>:8081 (IP trần; listener nội bộ của Nginx ép Host đúng).
API_INTERNAL_URL=http://api.localhost:8000
# Server-only, >= 32 ký tự, khớp INTERNAL_API_TOKEN của Laravel (throttle catalog theo nhóm SSR). Để trống ở local. KHÔNG dùng NEXT_PUBLIC_.
INTERNAL_API_TOKEN=
# Bản xem trước design v2 (/v2): ở production mặc định trả 404; đặt V2_PREVIEW=1 để mở (staging).
V2_PREVIEW=
# Origin app admin, chỉ cho liên kết ở trang xem trước /v2 (tuỳ chọn; để trống ở production).
NEXT_PUBLIC_ADMIN_URL=http://admin-api.localhost:3001
