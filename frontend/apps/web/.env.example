# Biến môi trường apps/web (schema: env.ts, env.server.ts). Giá trị dưới đây cho máy local
# theo ADR-004 §2.1. Copy thành .env.local (không commit). KHÔNG đặt secret vào NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://api.localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STATIC_URL=http://localhost:8080
# Danh sách host video, phân tách dấu phẩy (CSP connect-src/media-src)
NEXT_PUBLIC_VIDEO_HOSTS=video.localhost:8000
# Để trống ở local (chờ PO — G4)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Allowlist mở pay_url (S23); non-prod test-payment.momo.vn
NEXT_PUBLIC_MOMO_HOSTS=test-payment.momo.vn

# Server-only: Laravel gọi từ SSR. Chạy trong Docker Compose dùng host.docker.internal;
# chạy `next dev` thẳng trên máy thì đổi thành http://api.localhost:8000
API_INTERNAL_URL=http://host.docker.internal:8000
