{
  "name": "vitaminvui-frontend",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r --if-present run dev",
    "dev:web": "pnpm --filter @vitaminvui/web run dev",
    "dev:admin": "pnpm --filter @vitaminvui/admin run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "e2e": "pnpm -r --if-present run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.9"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "source-map-js": "1.2.2"
    }
  }
}
