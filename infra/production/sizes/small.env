# VV_SIZE=small: server 1 vCPU / 2 GB RAM (vd. Vultr 2 GB). Tổng mem_limit ~1,78 GB (+ swap 2 GB, README); là TRẦN, đo `docker stats` ở staging.
# Chỉ VideoLab TẮT (VV_VIDEOLAB=0); bật VideoLab trên máy này không đủ RAM. KHÔNG build image trên server (chỉ pull).
# mysql 540m (buffer pool 256M, performance_schema tắt) + php 380m (5 FPM child) + queue 160m + scheduler 128m + web 256m + admin 192m + redis 128m
VV_MYSQL_BUFFER_POOL=256M
VV_MYSQL_MEM_LIMIT=540m
VV_MYSQL_MAX_CONN=50
VV_MYSQL_REDO=512M
VV_MYSQL_PERF_SCHEMA=OFF
VV_FPM_CHILDREN=5
VV_FPM_START=2
VV_FPM_MIN_SPARE=1
VV_FPM_MAX_SPARE=3
VV_OPCACHE_MB=64
VV_PHP_MEM=380m
VV_QUEUE_REPLICAS=1
VV_QUEUE_MEM=160m
VV_SCHED_MEM=128m
VV_WEB_MEM=256m
VV_ADMIN_MEM=192m
VV_WEB_NODE_OPTIONS=--max-old-space-size=160
VV_ADMIN_NODE_OPTIONS=--max-old-space-size=112
VV_REDIS_MEM=128m
VV_REDIS_MAXMEM=64mb
