# VV_SIZE=large (mặc định): server 4 vCPU / 8 GB RAM dùng chung (ADR-008). Mọi giá trị trùng default trong docker-compose.yml; file này để đối chiếu
# với small.env và để `deploy.sh` luôn nạp một bộ rõ ràng. Muốn chỉnh riêng một giá trị: đặt lại trong /opt/vitaminvui/.env (thắng file này).
VV_MYSQL_BUFFER_POOL=2G
VV_MYSQL_MEM_LIMIT=3g
VV_MYSQL_MAX_CONN=100
VV_MYSQL_REDO=1G
VV_MYSQL_PERF_SCHEMA=ON
VV_FPM_CHILDREN=20
VV_FPM_START=4
VV_FPM_MIN_SPARE=2
VV_FPM_MAX_SPARE=6
VV_OPCACHE_MB=192
VV_PHP_MEM=2g
VV_QUEUE_REPLICAS=2
VV_QUEUE_MEM=768m
VV_SCHED_MEM=512m
VV_WEB_MEM=1g
VV_ADMIN_MEM=768m
VV_WEB_NODE_OPTIONS=
VV_ADMIN_NODE_OPTIONS=
VV_REDIS_MEM=1g
VV_REDIS_MAXMEM=0
