# VitaminVui — biến môi trường production/staging (MẪU, T31). KHÔNG chứa secret thật; không commit bản đã điền.
# Staging: đổi APP_ENV=staging, tên miền *-staging.vn, cookie vvstg_*, khoá và mật khẩu RIÊNG (không dùng lại của production).
# Nạp qua biến môi trường systemd/Supervisor hoặc secret manager; nếu dùng file thì chmod 600 và nằm ngoài web root.
# QUY TẮC: mỗi chú thích nằm trên DÒNG RIÊNG. KHÔNG viết `KEY=value # ghi chú`: docker `--env-file` và systemd `EnvironmentFile`
# giữ nguyên phần ghi chú trong giá trị (APP_ENV, token... sai mà không báo). ProductionConfigGuard chặn giá trị chứa ` #`.

APP_NAME=VitaminVui
# production | staging. TUYỆT ĐỐI không để local/testing trên server thật.
APP_ENV=production
# php artisan key:generate --show (khoá riêng mỗi môi trường)
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.vitaminvui.vn
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# --- Log (chính sách lưu giữ: docs/ops/production-checklist.md) ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
# Áp cho kênh payments, video, playback (IP + UA học sinh) và learning (không đặt biến này thì learning 14 ngày).
LOG_DAILY_DAYS=90

# --- Host & tên miền (ADR-004 §2) ---
APP_API_HOST=api.vitaminvui.vn
APP_ADMIN_API_HOST=admin-api.vitaminvui.vn
FRONTEND_URL=https://vitaminvui.vn
ADMIN_URL=https://admin.vitaminvui.vn
STATIC_URL=https://static.vitaminvui-media.net
UPLOADS_PATH=/var/www/uploads

# --- Phiên & proxy ---
SANCTUM_STATEFUL_DOMAINS=vitaminvui.vn,admin.vitaminvui.vn
SESSION_DRIVER=redis
SESSION_LIFETIME=10080
# C4-M1: mã hoá payload phiên trong Redis (giảm tác động khi Redis bị đọc). Bật cho cả host học sinh và admin.
# Bật/đổi giá trị này làm mọi phiên đang mở không đọc được: người dùng bị đăng xuất một lần (checklist mục 1.1).
SESSION_ENCRYPT=true
SESSION_PATH=/
# host-only
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# L3: tiền tố `__Host-` ép trình duyệt chỉ nhận cookie khi Secure + Path=/ + KHÔNG Domain (chống cookie tossing từ subdomain
# cùng site). Phải giữ SESSION_SECURE_COOKIE=true, SESSION_PATH=/, SESSION_DOMAIN=null. Local/test giữ tên cũ (http).
# staging: __Host-vvstg_session
SESSION_COOKIE=__Host-vv_session
# staging: __Host-vvstg_admin_session
SESSION_ADMIN_COOKIE=__Host-vv_admin_session
# IP cụ thể của load balancer/Next.js server, phân tách dấu phẩy. KHÔNG "*". Sai thì token CDN ràng IP và Location TUS sai scheme.
TRUSTED_PROXIES=<IP_LB_1>,<IP_NEXT_SERVER>

# SSR Next.js gửi X-Internal-Token + X-Client-IP; bật required ngay khi SSR đã cấu hình.
# openssl rand -hex 32 (≥ 32 ký tự)
INTERNAL_API_TOKEN=
INTERNAL_API_REQUIRED=true
CATALOG_LIMIT_PER_MINUTE=120
# Trần tổng/phút của nguồn SSR; cũng là trần DUY NHẤT cho request token đúng không kèm X-Client-IP (ADR-004 §2.8).
CATALOG_SSR_TOTAL_PER_MINUTE=6000

# --- Queue/cache ---
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=vitaminvui_cache
FILESYSTEM_DISK=local

# --- Database (user vv_app, không phải root; xem infra/production/mysql/grants.sql) ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=vitaminvui
DB_USERNAME=vv_app
DB_PASSWORD=

# --- Redis: có mật khẩu, chỉ nghe mạng nội bộ, DB tách riêng ---
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PORT=6379
# Redis ACL (infra/production/redis/users.acl): app dùng user `default` (hoặc user riêng toàn quyền); worker-video dùng
# user `vv_worker_video` (xem .env.worker-video.example). Để trống REDIS_USERNAME nếu app dùng user `default`.
REDIS_USERNAME=
REDIS_PASSWORD=
# worker-video phải trùng giá trị này
REDIS_PREFIX=vitaminvui-database-
REDIS_DB_SESSION=1
REDIS_CACHE_DB=2
REDIS_QUEUE_DB=3
REDIS_LIMITER_DB=4
# KHUYẾN NGHỊ (R2): Redis RIÊNG cho queue `video` (một instance nhỏ, ACL `redis/users.video-instance.acl`), vì worker-video bị chiếm có thể
# treo Redis bằng script Lua. Bỏ dấu # ở 4 dòng dưới để app dispatch TranscodeVideoJob sang đó; để nguyên thì dùng Redis chính.
# Biến để trống sẽ KHÔNG rơi về Redis chính: hoặc đặt giá trị thật, hoặc để nguyên dạng comment.
# REDIS_VIDEO_HOST=<REDIS_VIDEO_HOST>
# REDIS_VIDEO_PORT=6379
# REDIS_VIDEO_USERNAME=default
# REDIS_VIDEO_PASSWORD=<MAT_KHAU_REDIS_VIDEO>

# --- Mail (SMTP thật; PO/hạ tầng cung cấp) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@vitaminvui.vn"
MAIL_FROM_NAME="${APP_NAME}"

# --- Thanh toán: V2, MVP TẮT ---
FEATURE_PAID_CHECKOUT=false
# --- Thanh toán thủ công "Liên hệ Quản trị viên" (US-022, ADR-007) ---
# Giữ false cho tới khi PO gửi kênh liên hệ thật (Q1). Khi bật, guard bắt buộc: >= 1 kênh liên hệ (SĐT, Zalo hoặc email),
# danh sách ORDERS_MANUAL_NOTIFY_EMAILS không rỗng và hợp lệ, TTL 1..168 giờ, cửa sổ duyệt muộn 0..90 ngày, hạn mức 1..50 đơn/ngày.
# Thứ tự bật: chạy migration, deploy code, rồi mới bật cờ này. Chú thích đặt ở dòng riêng (không để cuối dòng giá trị).
FEATURE_MANUAL_PAYMENT=false
ORDERS_MANUAL_PENDING_TTL_HOURS=72
ORDERS_MANUAL_APPROVAL_WINDOW_DAYS=30
ORDERS_MANUAL_PER_DAY=5
ORDERS_MANUAL_NOTIFY_EMAILS=hotro@vitaminvui.vn
PAYMENT_CONTACT_PHONE="0915 592 224"
# Dạng https://zalo.me/<định-danh>
PAYMENT_CONTACT_ZALO_URL=https://zalo.me/0915592224
PAYMENT_CONTACT_EMAIL=hotro@vitaminvui.vn
PAYMENT_CONTACT_HOURS="8h–17h"
# để trống khi MVP; V2: momo. KHÔNG fake.
PAYMENT_GATEWAYS=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# production: https://payment.momo.vn/... (guard ép host)
MOMO_ENDPOINT=
MOMO_IPN_URL=
MOMO_REDIRECT_URL=
MOMO_REQUEST_TYPE=captureWallet
MOMO_LINK_TTL_MINUTES=30
# production chỉ giá trị này
MOMO_PAY_URL_HOSTS=payment.momo.vn

# --- Video ---
VIDEO_PROVIDER=internal
VIDEO_ENABLED_PROVIDERS=internal
VIDEO_MAX_UPLOAD_MB=1024
VIDEO_DAILY_QUOTA_GB=20

# --- Bunny Stream (US-021): bỏ dấu # khi chuyển sang Bunny, đặt VIDEO_PROVIDER=bunny (và VIDEO_ENABLED_PROVIDERS=bunny,internal
# nếu còn video VideoLab cũ). Thiếu một trong 4 biến đầu hoặc BUNNY_WEBHOOK_TOKEN (>= 32 ký tự, openssl rand -hex 32) khi Bunny bật thì ứng dụng không khởi động. Giá trị lấy từ trang Bunny
# (Stream > Library > API); lưu secret manager, KHÔNG commit. Chú thích đặt dòng riêng, không cuối dòng.
# BUNNY_LIBRARY_ID=
# BUNNY_API_KEY=
# BUNNY_CDN_HOST=
# BUNNY_TOKEN_KEY=
# BUNNY_WEBHOOK_TOKEN=

# --- VideoLab: khoá RIÊNG, mỗi cái ≥ 32 ký tự (openssl rand -hex 32), khác nhau; khác khoá staging ---
VIDEOLAB_ENABLED=true
VIDEOLAB_API_KEY=
VIDEOLAB_TOKEN_KEY=
VIDEOLAB_WEBHOOK_SECRET=
VIDEOLAB_HOST=video.vitaminvui.vn
VIDEOLAB_PUBLIC_URL=https://video.vitaminvui.vn
# App gọi VideoLab qua đâu (cùng máy: https://video.vitaminvui.vn hoặc địa chỉ nội bộ tới Nginx với Host video.*).
VIDEOLAB_INTERNAL_URL=
VIDEOLAB_WEBHOOK_URL=https://api.vitaminvui.vn/api/v1/webhooks/video/internal
VIDEOLAB_WEBHOOK_HOST=api.vitaminvui.vn
VIDEOLAB_PATH=/var/www/backend/storage/app/videolab
# bật cùng location /_protected_hls/ internal
VIDEOLAB_ACCEL_REDIRECT=true
VIDEOLAB_CHUNK_MAX_MB=8

# --- Chống bot & OTP ---
# fake bị guard chặn ở production VÀ staging
CAPTCHA_DRIVER=turnstile
# key thật (KHÔNG dùng key test 1x0000...)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# sms bị guard chặn
AUTH_OTP_CHANNELS=email
# phải false; guard chặn nếu true
AUTH_OTP_E2E_RELAXED=false

# --- Dữ liệu cá nhân ---
PRIVACY_POLICY_VERSION=2026-10-tam
PRIVACY_PARENT_CONTACT_SUGGEST_AGE=18
# BẮT BUỘC (guard chặn nếu rỗng/ngắn): khoá riêng >= 32 byte (`openssl rand -hex 32`), không dẫn xuất từ APP_KEY.
# KHÔNG ĐƯỢC XOAY sau khi chạy thật: xoay làm mất hiệu lực danh sách huỷ nhận của phụ huynh. Sao lưu cùng secrets.
PRIVACY_NOTICE_TOKEN_KEY=
# Trần thư/địa chỉ phụ huynh/24h, 1..20
PRIVACY_PARENT_NOTICE_DAILY_CAP=5

# --- Cờ tính năng: giá trị khuyến nghị MVP (xem checklist §1.3) ---
FEATURE_REFERRAL_CODE=true
FEATURE_QUIZ_TIME_LIMIT=true
FEATURE_ZERO_TOTAL_CHECKOUT=true
FEATURE_ENROLLMENT_DECISION_MAIL=true
FEATURE_STAFF_MFA=true
# Thư thông báo phụ huynh (ADR-006): cần mail thật hoạt động trước go-live
FEATURE_PARENT_NOTICES=true
FEATURE_EXTERNAL_VIDEO_PREVIEW_ONLY=true

# --- Vận hành (tuỳ chọn; mặc định trong config/ops.php) ---
# Trigger MySQL chặn xoá audit_logs ghi cứng 24 tháng (L2); `audit:purge` từ chối giá trị < 24.
OPS_AUDIT_RETENTION_MONTHS=24
# Địa chỉ hỗ trợ ghi trong thư báo đổi email tài khoản (H1).
SUPPORT_EMAIL=hotro@vitaminvui.vn
# OPS_WORKER_MAX_AGE=120
# OPS_SCHEDULER_MAX_AGE=180
# OPS_FAILED_JOBS_MAX=10
# OPS_QUEUE_BACKLOG_MAX=500
