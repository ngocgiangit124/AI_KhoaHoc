# VitaminVui — MySQL 8.4 production/staging (T35-1, ADR-008 §8.4; chỉnh theo DBA review D1). Mount vào /etc/mysql/conf.d/90-vitaminvui.cnf (chỉ đọc).
# KHÔNG chứa secret. KHÔNG đặt log_bin_trust_function_creators ở đây: deploy.sh bật bằng SET GLOBAL chỉ trong lúc migrate
# rồi trả về 0. Cờ ở my.cnf sẽ cho mọi user tạo/sửa routine/trigger khi binlog bật.
# innodb_buffer_pool_size KHÔNG đặt ở đây: compose truyền `--innodb-buffer-pool-size=${VV_MYSQL_BUFFER_POOL}` (production 2G, staging 1G,
# xem compose.env.example) cùng `mem_limit` của service mysql (VV_MYSQL_MEM_LIMIT).
[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
# Khớp CI/dev (docker-compose dev dùng READ-COMMITTED); code giả định mức này.
transaction-isolation = READ-COMMITTED
# KHÔNG đặt binlog_format: mặc định đã là ROW, đặt tường minh chỉ gây cảnh báo "deprecated" mỗi lần khởi động ở 8.4.
# Binlog giữ 7 ngày TRÊN ĐĨA (nhỏ) để hỗ trợ khôi phục tay khi cần; KHÔNG sao lưu ra ngoài. Backup chính = snapshot ổ đĩa của nhà cung cấp (PO 2026-10-10).
binlog_expire_logs_seconds = 604800
# grants-users.sql ràng user theo IP mạng Docker (10.231.11.%, 10.231.12.%): không phân giải tên ngược.
skip-name-resolve = ON
# Không dùng X Protocol (cổng 33060): bớt bề mặt và RAM.
mysqlx = OFF
# Cố định hành vi: container chạy UTC. Laravel KHÔNG đặt time_zone cho phiên MySQL; APP_TIMEZONE=Asia/Ho_Chi_Minh ghi chuỗi giờ ICT
# nguyên văn vào cột (round-trip đúng). Hệ quả: SQL thô dùng NOW()/CURDATE() lệch 7 giờ so với giờ ICT của app (trigger audit_logs có
# đệm 1 ngày nên không ảnh hưởng audit:purge).
default-time-zone = '+00:00'
# Đỉnh ước tính ~35 kết nối (20 FPM + 2 queue + schedule + worker + quản trị). 100 là dư; cộng thêm nếu tăng FPM_MAX_CHILDREN/replica queue.
max_connections = 100
# Mặc định 100 MB quá nhỏ với heartbeat tiến độ bài học (ghi liên tục): checkpoint dồn. Đổi động được, không cần restart.
innodb_redo_log_capacity = 1G
# Deadlock (checkout/IPN) vào error log (docker logs mysql) thay vì chỉ SHOW ENGINE INNODB STATUS.
innodb_print_all_deadlocks = ON
# GIỮ innodb_flush_log_at_trx_commit=1 và sync_binlog=1 (mặc định): dữ liệu đơn hàng/thanh toán/audit, không nới.
local_infile = OFF
# Slow log BẬT (đo p95 /me/courses, checklist §5). PDO của Laravel dùng prepared statement thật nên log chỉ có dấu `?`, không có giá trị
# tham số. NẾU sau này bật PDO::ATTR_EMULATE_PREPARES thì PHẢI tắt slow log. Xoay file bằng cron hằng tuần (README).
slow_query_log = ON
long_query_time = 1
min_examined_row_limit = 100
log_slow_extra = ON
slow_query_log_file = /var/lib/mysql/slow.log
