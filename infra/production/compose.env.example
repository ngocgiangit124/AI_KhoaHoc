# /opt/vitaminvui/.env — biến nội suy của docker-compose.yml (T35-1). KHÔNG chứa secret. deploy.sh tự cập nhật IMAGE_TAG/PREVIOUS_TAG.
# staging | production. Dùng cho tag image web/admin (vitaminvui-web:<VV_ENV>-<sha>) và để deploy.sh kiểm label `vv.env`.
VV_ENV=production
VV_REGISTRY=ghcr.io/ngocgiangit124
# 40 ký tự hex của commit đang chạy. Để trống ở lần dựng đầu, deploy.sh ghi sau lần deploy thành công đầu tiên.
IMAGE_TAG=
PREVIOUS_TAG=
# Đổi nếu trùng mạng nội bộ của nhà cung cấp server. Nếu đổi: sửa cả allow/listen của Nginx (10.231.10.x), host trong grants-users.sql (10.231.11.%, 10.231.12.%), TRUSTED_PROXIES và API_INTERNAL_URL.
VV_SUBNET_FRONT=10.231.10.0/24
VV_SUBNET_APP=10.231.11.0/24
VV_SUBNET_VIDEO=10.231.12.0/24
# Cỡ máy: large (mặc định, 4 vCPU / 8 GB) hoặc small (1 vCPU / 2 GB, VideoLab phải TẮT). Chọn bộ giá trị trong sizes/<cỡ>.env (bộ nhớ MySQL/PHP/queue/
# web/admin, số child FPM, số queue). Muốn chỉnh riêng từng giá trị: đặt lại dưới đây (.env thắng sizes/*.env). Copy thư mục sizes/ cùng docker-compose.yml.
VV_SIZE=large
# MySQL (DBA D1): theo VV_SIZE trong sizes/*.env (large: pool 2G + mem_limit 3g; small: 256M + 540m). Staging 4 GB: bỏ comment 2 dòng dưới.
# VV_MYSQL_BUFFER_POOL=1G
# VV_MYSQL_MEM_LIMIT=2g
# VideoLab (worker-video + redis-video + host `video.`): TẮT ở V1 (video qua Bunny, quyết định PO 2026-10-10). Đặt 1 để bật profile compose `videolab`
# và các bước worker của deploy.sh (cần thêm env/worker-video.env, conf/redis-video.conf, conf/users.video-instance.acl, conf/grants-worker.sql,
# VIDEOLAB_*/REDIS_VIDEO_* trong app.env, Nginx optional/videolab.conf). T35-3 chỉ build/ký image worker-video khi biến này bật.
VV_VIDEOLAB=0
# Host của user vv_worker_video (chỉ khi VV_VIDEOLAB=1) trong MySQL (khớp <WORKER_HOST> của grants-users.sql). Đổi cùng VV_SUBNET_VIDEO.
VV_WORKER_DB_HOST=10.231.12.%
# BẮT BUỘC khi không --local (S2): digest của image sẽ chạy, dán từ images-*.lock của run CI trước mỗi deploy (lấy qua kênh khác server). Dạng sha256:<64 hex>.
# deploy.sh dừng trước khi pull nếu thiếu, và dừng nếu image kéo về lệch.
IMAGE_DIGEST_BACKEND=
IMAGE_DIGEST_WEB=
IMAGE_DIGEST_ADMIN=
# Chỉ khi VV_VIDEOLAB=1:
# IMAGE_DIGEST_WORKER_VIDEO=
# Production: BẬT (V3-4). Staging có thể để 0. 1 = chạy `cosign verify` (identity workflow main, docs/ops/ci.md) cho từng image trước khi đổi gì. Cần cosign trên server.
VV_COSIGN_VERIFY=1
