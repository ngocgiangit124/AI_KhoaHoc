# worker-video production (T12-6/T12-10). Nạp từ file ngoài thư mục mã nguồn: /opt/vitaminvui/env/worker-video.env (chmod 600, compose `env_file`; ADR-008 §8.6).
# KHÁC app: APP_ENV, APP_KEY, REDIS_PREFIX... KHÔNG chứa khoá thanh toán, SMTP, Turnstile, khoá VideoLab của app.
# LƯU Ý: ProductionConfigGuard chạy cả trong `queue:work` (AppServiceProvider::boot), nên MỌI biến mà guard kiểm
# (debug, cookie secure, stateful domains, captcha, trusted proxies...) phải có giá trị hợp lệ ở đây dù worker không phục vụ HTTP.
# Test `tests/Feature/T31/WorkerVideoEnvTest.php` nạp đúng file này và chạy guard.
APP_NAME=VitaminVui
APP_ENV=production
# Phải giống app (finished_at/notified_at cùng múi giờ).
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_DEBUG=false
# APP_KEY RIÊNG của worker (php artisan key:generate --show). Worker không giải mã session/cookie của app nên không cần trùng.
APP_KEY=<APP_KEY_RIENG_CUA_WORKER>
LOG_CHANNEL=stderr

# Chỉ để qua ProductionConfigGuard (worker không phục vụ HTTP).
SESSION_SECURE_COOKIE=true
# Guard cũng kiểm SESSION_ENCRYPT (C4-M1).
SESSION_ENCRYPT=true
# Guard so SANCTUM_STATEFUL_DOMAINS với host của FRONTEND_URL/ADMIN_URL (C4-L5): hai biến này phải khớp app.
FRONTEND_URL=https://vitaminvui.vn
ADMIN_URL=https://admin.vitaminvui.vn
SANCTUM_STATEFUL_DOMAINS=vitaminvui.vn,admin.vitaminvui.vn
# Guard (US-020, T36) đòi STATIC_URL là https và KHÁC host/miền cha-con của APP_URL, FRONTEND_URL, ADMIN_URL: phải giống app.
STATIC_URL=https://static.vitaminvui-media.net
CAPTCHA_DRIVER=turnstile
# Guard (GL-1) cấm MAIL_MAILER=log/array. Worker video KHÔNG gửi thư: dòng này chỉ để qua guard khởi động. KHÔNG đặt MAIL_HOST,
# MAIL_USERNAME, MAIL_PASSWORD (SMTP thật) vào worker (nguyên tắc tối thiểu secret).
# TURNSTILE_SECRET không cần: captcha chỉ chạy ở request HTTP, tiến trình console được miễn.
MAIL_MAILER=smtp
TRUSTED_PROXIES=
# Mặc định code là `fake` (guard cấm ở production): worker không thanh toán nên để rỗng.
PAYMENT_GATEWAYS=
# Guard (T29) đòi khoá này ở MỌI tiến trình, kể cả worker (phát hiện khi dựng smoke T35-1). Worker KHÔNG ký/kiểm token huỷ nhận thư phụ huynh:
# đặt khoá ngẫu nhiên RIÊNG >= 32 byte (`openssl rand -hex 32`), KHÔNG dùng khoá của app.env (worker bị chiếm không được lộ khoá đó).
PRIVACY_NOTICE_TOKEN_KEY=

# PHẢI trùng prefix Redis của app (nếu lệch, worker không thấy queue `video`). App mặc định: slug(APP_NAME)-database-.
REDIS_PREFIX=vitaminvui-database-
# Redis video riêng (R2): worker không chạm Redis chính, nên cache là mảng trong bộ nhớ. `queue:restart`/`queue:pause` không tới worker.
CACHE_STORE=array
CACHE_PREFIX=vitaminvui_cache
QUEUE_CONNECTION=redis

DB_CONNECTION=mysql
# Tên service compose; worker ở mạng video (10.231.12.0/24), user DB ràng host 10.231.12.% (grants-users.sql).
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vitaminvui
DB_USERNAME=vv_worker_video
DB_PASSWORD=<MAT_KHAU_WORKER>

REDIS_CLIENT=phpredis
# KHÔNG đặt REDIS_HOST/REDIS_USERNAME/REDIS_PASSWORD của Redis chính: worker không có đường tới Redis chính (mạng video) và không nên có mật khẩu của nó.
# Không đặt REDIS_DB_SESSION/REDIS_LIMITER_DB: worker không dùng session/limiter.
REDIS_CACHE_DB=2
REDIS_QUEUE_DB=3
# R2 (ADR-008): Redis riêng cho queue `video`; user ACL RIÊNG của worker (redis/users.video-instance.acl), KHÔNG dùng mật khẩu của user `default`.
# Chỉ đụng key queue `video`; không đọc được phiên, không ghi được `queues:default`. Phải cùng host/port/DB/prefix với app.env.
REDIS_VIDEO_HOST=redis-video
REDIS_VIDEO_PORT=6379
REDIS_VIDEO_USERNAME=vv_worker_video
REDIS_VIDEO_PASSWORD=<MAT_KHAU_ACL_CUA_WORKER>

# VideoLab: worker KHÔNG dispatch/gọi webhook (C4-M1: `videolab:notify` của scheduler app dispatch, worker `vitaminvui-queue` gửi) và không ký/kiểm
# token, nên đặt VIDEOLAB_ENABLED=false: không cần (và không nên có) khoá VIDEOLAB_* của app trong môi trường này
# (worker bị chiếm sẽ không lộ khoá ký token CDN). `enabled` chỉ điều khiển route/migration/provider, không ảnh hưởng
# TranscodeVideoJob. Dev kiểm lại trên container thật khi dựng worker (gửi thử một video).
VIDEOLAB_ENABLED=false
VIDEOLAB_PATH=/var/www/backend/storage/app/videolab
