user default on #<SHA256_MAT_KHAU_APP> ~* &* +@all
user vv_worker_video on #<SHA256_MAT_KHAU_WORKER> resetkeys resetchannels -@all +eval +lpop +rpush +zadd +zrem +zrangebyscore +zremrangebyrank +llen +zcard +blpop +select +ping +get +mget ~<PREFIX>queues:video ~<PREFIX>queues:video:delayed ~<PREFIX>queues:video:notify ~<PREFIX>queues:video:reserved %R~<PREFIX><CACHE_PREFIX>illuminate:queue:restart %R~<PREFIX><CACHE_PREFIX>illuminate:queues:paused %R~<PREFIX><CACHE_PREFIX>illuminate:queue:paused:redis_video:video
user vv_healthcheck on nopass resetkeys resetchannels -@all +ping
