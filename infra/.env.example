# M6 (review bảo mật T01/T02) — copy file này thành infra/.env (đã có trong
# .gitignore, KHÔNG commit) rồi đặt giá trị thật. docker-compose.yml không còn
# giá trị mặc định "secret" — thiếu file này, `docker compose up` sẽ báo lỗi
# rõ ràng thay vì âm thầm chạy với mật khẩu yếu, ai đọc code cũng đoán được.
#
# QUAN TRỌNG: VV_DB_PASSWORD và VV_REDIS_PASSWORD phải KHỚP ĐÚNG với
# DB_PASSWORD và REDIS_PASSWORD trong backend/.env — đây là 2 file .env riêng
# biệt (1 cho hạ tầng Docker, 1 cho ứng dụng Laravel) mô tả CÙNG một thứ
# (mật khẩu kết nối MySQL/Redis), không đồng bộ thì container `php` sẽ không
# kết nối được.

VV_UID=1000
VV_GID=1000

VV_DB_ROOT_PASSWORD=doi_mat_khau_root_local
VV_DB_DATABASE=vitaminvui
VV_DB_USERNAME=vitaminvui
VV_DB_PASSWORD=doi_mat_khau_db_local

VV_REDIS_PASSWORD=doi_mat_khau_redis_local
