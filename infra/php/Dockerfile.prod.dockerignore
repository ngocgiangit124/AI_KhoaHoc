# Allowlist: chỉ backend/ và infra/php/prod/ vào context. Loại mọi thứ có thể chứa secret hoặc dữ liệu dev.
*
!backend
!infra/php/prod

backend/.env
backend/.env.*
backend/vendor
backend/node_modules
backend/storage
backend/tests
backend/phpunit*.xml
backend/phpstan.neon
backend/bootstrap/cache
backend/public/hot
backend/public/storage
**/.git
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.log
**/.DS_Store
**/.claude
**/.cursor
**/.codex
**/.idea
**/.vscode
backend/.editorconfig
backend/.gitattributes
backend/.gitignore
backend/README.md
backend/database/*.sqlite
